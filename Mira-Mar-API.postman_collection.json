{
  "info": {
    "name": "Mira Mar API - Complete Testing",
    "description": "Colección completa de endpoints del backend Mira Mar con DTOs optimizados",
    "version": "1.0.0",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apiKey",
    "apiKey": [
      {
        "key": "value",
        "value": "user_session={{user_session}}",
        "type": "string"
      },
      {
        "key": "key",
        "value": "Cookie",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login Client",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var cookieValue = postman.getResponseCookie('user_session');",
                  "    pm.environment.set('user_session', cookieValue.value);",
                  "    console.log('Session saved: ' + cookieValue.value);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"usuario1\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/auth/login",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Register Client",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan García\",\n  \"usuario\": \"juangarcia\",\n  \"email\": \"juan@example.com\",\n  \"contrasena\": \"SecurePass123\",\n  \"contrasenaConfirm\": \"SecurePass123\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/auth/register",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/auth/logout",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Reservations",
      "item": [
        {
          "name": "List All Reservations (Paginated)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/reservations/all",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["reservations", "all"]
            },
            "description": "✓ Retorna ReservationMinimalDTO (sin datos anidados innecesarios)\n✓ Solo: id, fechaInicio, fechaFin, estado, roomId, roomNombre"
          }
        },
        {
          "name": "Get Reservation by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/reservations/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["reservations", "1"]
            },
            "description": "✓ Retorna ReservationResponseDTO con:\n- Cliente: id, nombre, email (sin contrasena, telefono, fotoPerfil)\n- Room: id, nombre, tipoHabitacion: id, nombre"
          }
        },
        {
          "name": "Create Reservation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roomTypeId\": 1,\n  \"fechaInicio\": \"2026-05-25\",\n  \"fechaFin\": \"2026-05-28\",\n  \"cantidadPersonas\": 2\n}"
            },
            "url": {
              "raw": "http://localhost:8080/reservations/add",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["reservations", "add"]

            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"CONFIRMED\"\n}"
            },
            "url": {
              "raw": "http://localhost:8080/reservations/1/status",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["reservations", "1", "status"]

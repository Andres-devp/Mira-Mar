    {
      "name": "Security Tests",
      "item": [
        {
          "name": "TEST: Operator Response No Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Operator DTO debe NO contener contrasena', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData[0]).not.to.have.property('contrasena');",
                  "});",
                  "",
                  "pm.test('Operator DTO debe NO contener cedula', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData[0]).not.to.have.property('cedula');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/operator/all",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["operator", "all"]
            }
          }
        },
        {
          "name": "TEST: Reservation No Client Password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Reservation DTO debe NO contener client.contrasena', function() {",
                  "    var jsonData = pm.response.json();",
                  "    var reservation = jsonData[0];",
                  "    pm.expect(reservation).not.to.have.property('client.contrasena');",
                  "    pm.expect(reservation.clientEmail).to.exist;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/reservations/1",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["reservations", "1"]
            }
          }
        },
        {
          "name": "TEST: Room Type No Habitaciones Array",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('RoomType DTO debe NO contener habitaciones[] array', function() {",
                  "    var jsonData = pm.response.json();",
                  "    var roomType = jsonData[0];",
                  "    pm.expect(roomType).not.to.have.property('habitaciones');",
                  "    pm.expect(roomType.cantidadHabitaciones).to.exist;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/roomtypes/all",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["roomtypes", "all"]
            }

        },
        {
          "name": "Get Reservation Items",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:8080/reservations/1/items",
              "protocol": "http",
              "host": ["localhost"],
              "port": "8080",
              "path": ["reservations", "1", "items"]

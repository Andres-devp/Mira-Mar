            "description": "⚠️ Requiere cookie user_session (login primero)"
          }
        },
        {
          "name": "Update Reservation Status",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
